# Copy to .env.local (gitignored). Never commit real keys.

# ── Solana / Helius (x402 live send + JTX gate) ──────────────────────────
# Prefer HELIUS_API_KEY or full SOLANA_RPC_URL on the *server* only.
# Browser uses same-origin POST /api/solana-rpc (proxy) so the key is not
# bundled into the client.
HELIUS_API_KEY=
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Optional client fallback only (avoid in production — exposes key):
# VITE_SOLANA_RPC_URL=

# ── x402 ─────────────────────────────────────────────────────────────────
# Server-only. LIVE settle + /api/mojo/broadcast require this exact flag.
# Client X-X402-MODE / body.mode / VITE_* cannot enable LIVE.
# X402_LIVE_ENABLED=false

# ── JTX product gate (server) ───────────────────────────────────────────
# Discover POSTs: X-Solana-Wallet + ≥1 JTX + per-wallet rate limit.
# Settle/mojo POSTs: also require X-JTX-Proof (ed25519 over jOSH-X-Wealth-v0.1:…).
# Buy: https://astroknots.space/buy
# Local/CI only — never enable in production:
# JTX_GATE_DISABLED=true
# Optional extra CORS origins (comma-separated) for gated responses:
# JTX_CORS_ORIGINS=https://preview.example.com

# ── Privy (optional) ─────────────────────────────────────────────────────
# VITE_PRIVY_APP_ID=
# VITE_PRIVY_ENABLED=true
