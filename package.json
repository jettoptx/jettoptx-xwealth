{
  "name": "@jettoptx/xwealth",
  "version": "0.1.0",
  "description": "Agentic X Money wallet plugin for OPTX — graph nodes for Hermes/OpenClaw, JTX v2 gated, Solana + X payments",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/**/*.mjs",
    "dry-run": "npm run build && node scripts/dry-run.mjs",
    "setup": "node scripts/setup-plugin.mjs",
    "check-wallet": "node scripts/check-wallet.mjs",
    "check-jtx": "node scripts/check-jtx-gate.mjs",
    "agent-cards:setup": "node scripts/agent-cards-setup.mjs",
    "agent-cards:wizard": "npx -y agent-cards companies wizard --agent --yes --app-name \"X Wealth\" --app-url http://localhost:3001 --path .",
    "agent-cards:mcp-help": "npx -y agent-cards setup-mcp --help",
    "mcp:paper": "python mcp/jtx-trade-paper/server.py",
    "mcp:paper:smoke": "python mcp/jtx-trade-paper/smoke_test.py",
    "mcp:paper:cli": "python mcp/jtx-trade-paper/cli.py",
    "digest:bookmarks": "node scripts/digest-bookmarks.mjs",
    "high-stakes:mint": "node scripts/high-stakes-cli.mjs mint",
    "high-stakes:status": "node scripts/high-stakes-cli.mjs status",
    "high-stakes:wait": "node scripts/high-stakes-cli.mjs wait",
    "high-stakes": "node scripts/high-stakes-cli.mjs"
  },
  "keywords": [
    "optx",
    "jettoptx",
    "x-money",
    "agentic",
    "wallet",
    "solana",
    "hermes",
    "openclaw",
    "jtx"
  ],
  "author": "Jett Optics",
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.95.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  }
}
